# ==============================================================================
# Server-only Environment Variables (Vercel Project Settings > Environment Variables)
# IMPORTANT: Never prefix secret keys with VITE_ (VITE_* is embedded into client JS).
# ==============================================================================

# Optional Gemini API key for future AI features (kept strictly server-side).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public deployment URL (automatically populated in Vercel via VERCEL_URL,
# or set explicitly for custom domains / CORS origin validation).
APP_URL="MY_APP_URL"

# Optional comma-separated extra origins allowed for CORS (e.g. https://example.com)
ALLOWED_ORIGIN=

# ==============================================================================
# Client-side Environment Variables (Exposed to browser via import.meta.env)
# ==============================================================================

# Optional API base URL when hosting frontend and serverless API separately.
# Leave empty when deploying together on Vercel so requests use same-origin /api/*.
VITE_API_BASE_URL=
